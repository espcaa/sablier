package views

import "strings"

type Consent struct {
	Name      string
	Port      string
	State     string
	Challenge string
}

type Done struct {
	Error string
}

func firstName(name string) string {
	return strings.Split(name, " ")[0]
}

templ CLIConsent(c Consent) {
	@layout("Allow sablier CLI") {
		@cliStyles()
		<a class="small-name" href="/">sablier</a>
		<section class="card">
			<h1>Link the CLI to your account?</h1>
			<p class="muted">You're { firstName(c.Name) }. Only allow this if you just ran <code>sablier login</code>.</p>
			<form method="post" action="/cli/authorize" class="actions">
				<input type="hidden" name="port" value={ c.Port }/>
				<input type="hidden" name="state" value={ c.State }/>
				<input type="hidden" name="code_challenge" value={ c.Challenge }/>
				<input type="hidden" name="code_challenge_method" value="S256"/>
				<button class="button quiet" type="submit" name="decision" value="deny">Cancel</button>
				<button class="button" type="submit" name="decision" value="allow" autofocus>Allow</button>
			</form>
		</section>
	}
}

templ CLIDone(d Done) {
	@layout("sablier") {
		@cliStyles()
		<a class="small-name" href="/">sablier</a>
		<section class="card done">
			if d.Error == "" {
				<div class="mark ok" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
				</div>
				<h1>You're signed in!</h1>
			} else {
				<div class="mark bad" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M7 7l10 10M17 7L7 17"></path></svg>
				</div>
				<h1>Sign in didn't finish</h1>
				<p class="muted">{ d.Error }. Try <code>sablier login</code> again.</p>
			}
		</section>
	}
}

templ cliStyles() {
	<style>
		.card {
			width: 100%;
			margin-top: 1.5rem;
			padding: 2rem;
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			border-radius: calc(var(--radius) * 2);
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}
		.card h1 {
			font-size: 1.5rem;
			font-weight: 600;
			letter-spacing: -0.02em;
			line-height: 1.2;
		}
		.actions {
			display: flex;
			justify-content: flex-end;
			gap: 0.75rem;
			margin-top: 0.5rem;
		}
		.actions .button.quiet {
			padding: 0.6rem 1.4rem;
		}
		.done {
			align-items: center;
			text-align: center;
		}
		.mark {
			width: 4.5rem;
			height: 4.5rem;
			border-radius: 50%;
			display: grid;
			place-items: center;
			color: var(--color-surface);
		}
		.mark.ok {
			background: var(--color-accent);
			animation: pop 400ms cubic-bezier(.2, 1.4, .4, 1);
		}
		.mark.bad {
			background: var(--color-danger);
		}
		@keyframes pop {
			from { transform: scale(0.4); opacity: 0; }
		}
		@media (prefers-reduced-motion: reduce) {
			.mark.ok { animation: none; }
		}
	</style>
}
