package views

templ top(me Me) {
	<header class="top">
		<a class="small-name" href="/app">sablier</a>
		<div class="account">
			@avatar(me.Name, me.SlackID)
			@linkButton(iconOnly, "/app/settings", templ.Attributes{"aria-label": "Settings", "title": "Settings"}) {
				@icon("settings")
			}
			<form method="post" action="/auth/logout">
				@button(iconOnly, "submit", templ.Attributes{"aria-label": "Sign out", "title": "Sign out"}) {
					@icon("log-out")
				}
			</form>
		</div>
	</header>
	@topStyles()
}

templ topStyles() {
	<style>
		.top {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 2rem;
		}
		.small-name {
			font-weight: 600;
			font-style: italic;
			font-size: 1.6rem;
			letter-spacing: -0.03em;
			color: var(--color-ink);
			text-decoration: none;
		}
		.account {
			display: flex;
			align-items: center;
			gap: 0.75rem;
		}
	</style>
}
