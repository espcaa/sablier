package views

import "time"

type Me struct {
	Name    string
	SlackID string // can be empty cause an hcauth account doesn't always have a slack id
	APIKey  string
	Today   Summary
	AllTime Summary
}

type Summary struct {
	Total     time.Duration
	Projects  []Entry // most time first, same for the others
	Harnesses []Entry
	Models    []Entry
}

type Entry struct {
	Name string
	Time time.Duration
}

templ App(me Me) {
	@layout("sablier") {
		@top(me)
		<p class="sentence">
			if me.Today.Total == 0 {
				Nothing tracked today yet. Start your agent through sablier and it shows up here.
			} else {
				@templ.Raw(sentence(me.Today))
			}
		</p>
		<div class="cards">
			if len(me.AllTime.Projects) > 0 {
				@card("Projects") {
					@bars(me.AllTime.Projects)
				}
			}
			@modelUsage(me.AllTime)
		</div>
		@appStyles()
	}
}

templ appStyles() {
	<style>
		.sentence {
			max-width: 48rem;
			font-size: 1.6rem;
			line-height: 1.35;
			letter-spacing: -0.01em;
			margin: 0.5rem 0 0;
			text-wrap: pretty;
		}
		.sentence strong {
			font-weight: 600;
			white-space: nowrap;
		}
		.sentence .total {
			font-style: italic;
			color: var(--color-accent);
			font-variant-numeric: tabular-nums;
		}
		.cards {
			margin-top: 2.5rem;
			display: flex;
			flex-wrap: wrap;
			align-items: start;
			gap: 1.5rem;
		}
		.cards > .card {
			flex: 1 1 22rem;
			min-width: 0;
			max-width: 36rem;
		}
	</style>
}
