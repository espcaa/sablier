package views

import "time"

type Me struct {
	Name    string
	SlackID string // can be empty cause an hcauth account doesn't always have a slack id
	APIKey  string
	Today   Summary
	AllTime Summary
}

type Summary struct {
	Total     time.Duration
	Projects  []Entry // most time first, same for the others
	Harnesses []Entry
	Models    []Entry
}

type Entry struct {
	Name string
	Time time.Duration
}

templ App(me Me) {
	@layout("sablier") {
		@top(me)
		<p class="sentence">
			if me.Today.Total == 0 {
				Nothing tracked today yet. Start your agent through sablier and it shows up here.
			} else {
				@templ.Raw(sentence(me.Today))
			}
		</p>
		<div class="cards">
			if len(me.AllTime.Projects) > 0 {
				@card("Projects") {
					@bars(me.AllTime.Projects)
				}
			}
		</div>
		@appStyles()
	}
}

templ Settings(me Me) {
	@layout("settings · sablier") {
		@top(me)
		<h1 class="page-title">Settings</h1>
		<section class="key">
			<h2>API key</h2>
			@copyField(me.APIKey)
		</section>
		@appStyles()
	}
}

templ top(me Me) {
	<header class="top">
		<a class="small-name" href="/app">sablier</a>
		<div class="account">
			@avatar(me.Name, me.SlackID)
			@linkButton(iconOnly, "/app/settings", templ.Attributes{"aria-label": "Settings", "title": "Settings"}) {
				@icon("settings")
			}
			<form method="post" action="/auth/logout">
				@button(iconOnly, "submit", templ.Attributes{"aria-label": "Sign out", "title": "Sign out"}) {
					@icon("log-out")
				}
			</form>
		</div>
	</header>
}

templ appStyles() {
	<style>
		.top {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 2rem;
		}
		.small-name {
			font-weight: 600;
			font-style: italic;
			font-size: 1.6rem;
			letter-spacing: -0.03em;
			color: var(--color-ink);
			text-decoration: none;
		}
		.account {
			display: flex;
			align-items: center;
			gap: 0.75rem;
		}
		.sentence {
			max-width: 48rem;
			font-size: 1.6rem;
			line-height: 1.35;
			letter-spacing: -0.01em;
			margin: 0.5rem 0 0;
			text-wrap: pretty;
		}
		.sentence strong {
			font-weight: 600;
			white-space: nowrap;
		}
		.sentence .total {
			font-style: italic;
			color: var(--color-accent);
			font-variant-numeric: tabular-nums;
		}
		.cards {
			margin-top: 2.5rem;
			display: flex;
			flex-wrap: wrap;
			align-items: start;
			gap: 1.5rem;
		}
		.key {
			max-width: 40rem;
			margin-top: 1.5rem;
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
		}
		.key h2 {
			font-size: 1rem;
			font-weight: 600;
		}
		.page-title {
			font-size: 1.6rem;
			font-weight: 600;
			letter-spacing: -0.01em;
		}
		.cards > .card {
			flex: 1 1 22rem;
			min-width: 0;
			max-width: 36rem;
		}
	</style>
}
