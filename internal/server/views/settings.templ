package views

type Device struct {
 Hostname string
	ID string
	Created string
}

templ Settings(me Me, devices []Device) {
	@layout("settings · sablier") {
		@top(me)
		<h1 class="page-title">Settings</h1>
		<section class="key">
			<h2>Connected CLI devices</h2>
			if len(devices) == 0 {
				<p>No connected devices. Run <code>sablier login</code> to connect one.</p>
			}
			for _, device := range devices {
				<form method="post" action="/app/settings/revoke">
					<input type="hidden" name="id" value={ device.ID }/>
					if device.Hostname != "" {
						<strong>{ device.Hostname }</strong>
					} else {
						<strong>Unknown device</strong>
					}
					<code>{ device.ID }</code>
					<span>{ device.Created }</span>
					<button class="button quiet" type="submit">Revoke</button>
				</form>
			}
		</section>
		@settingsStyles()
	}
}

templ settingsStyles() {
	<style>
		.key {
			max-width: 40rem;
			margin-top: 1.5rem;
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
		}
		.key h2 {
			font-size: 1rem;
			font-weight: 600;
		}
		.page-title {
			font-size: 1.6rem;
			font-weight: 600;
			letter-spacing: -0.01em;
		}
	</style>
}
