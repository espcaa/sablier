SABLIER_ADDR=:8080
SABLIER_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://sablier:sablier@localhost:5433/sablier?sslmode=disable

# auth.hackclub.com app, redirect uri: $SABLIER_BASE_URL/auth/callback
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=

# comma-separated hca ids for admin analytics access
SABLIER_ADMIN_USER_IDS=

# the built website
SABLIER_SITE_DIR=website/dist

# in dev, proxy the site to astro dev instead
# SABLIER_SITE_PROXY=http://localhost:4321

# decision model used by sablier verify, required
DECISION_API_KEY=
DECISION_API_URL=
